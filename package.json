{
  "name": "tvbox-apps",
  "private": true,
  "type": "module",
  "description": "tvbox app registry \u2014 self-contained app packages (manifest + host plugin + built web UI) and their standalone Vite sources.",
  "scripts": {
    "build:files": "vite build -c apps-src/files/vite.config.ts",
    "build:livetv": "vite build -c apps-src/livetv/vite.config.ts",
    "build:mediaclient": "vite build -c apps-src/mediaclient/vite.config.ts",
    "build:retroarch": "vite build -c apps-src/retroarch/vite.config.ts",
    "build:spotify": "vite build -c apps-src/spotify/vite.config.ts",
    "build:xcloud": "vite build -c apps-src/xcloud/vite.config.ts",
    "typecheck:files": "tsc --noEmit -p apps-src/files/tsconfig.json",
    "typecheck:livetv": "tsc --noEmit -p apps-src/livetv/tsconfig.json",
    "typecheck:mediaclient": "tsc --noEmit -p apps-src/mediaclient/tsconfig.json",
    "typecheck:retroarch": "tsc --noEmit -p apps-src/retroarch/tsconfig.json",
    "typecheck:spotify": "tsc --noEmit -p apps-src/spotify/tsconfig.json",
    "typecheck:xcloud": "tsc --noEmit -p apps-src/xcloud/tsconfig.json",
    "index": "node scripts/build-index.mjs",
    "store:serve": "node scripts/serve-store.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^3.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
